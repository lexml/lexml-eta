<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture derivada de docs/extensao-formato-lexml/11-revisao-da-hierarquia.md — reúne todos os
     exemplos de operação do arquivo (um por lexedit:RevisaoArticulacao) num único documento,
     já que lexedit:RevisoesArticulacao ocorre no máximo uma vez por lexedit:Metadado.
     lexedit:Usuarios foi acrescentado por completude (ver nota em 08-comentarios.xml). -->
<lexedit:Metadado xmlns='http://www.lexml.gov.br/1.0' xmlns:lexedit='http://www.lexml.gov.br/lexedit/1.0'>
  <lexedit:RevisoesArticulacao>

    <!-- Inclusão de dispositivo -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art4"
        revisao="adicionado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00"/>

    <!-- Exclusão de dispositivo -->
    <lexedit:RevisaoArticulacao
        revisao="excluido"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Artigo id="_art3-exc1">
        <Rotulo>Art. 3º</Rotulo>
        <Caput id="_art3-exc1_cpt">
          <p>Orig. 3</p>
        </Caput>
      </Artigo>
    </lexedit:RevisaoArticulacao>

    <!-- Alteração de texto de dispositivo: o estado anterior é um dispositivo do mesmo tipo, sem id -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art4_cpt_inc2"
        revisao="alterado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Inciso>
        <p>Texto original do dispositivo</p>
      </Inciso>
    </lexedit:RevisaoArticulacao>

    <!-- Alteração do texto de um dispositivo com título: o título anterior acompanha o texto -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art6_cpt_inc1"
        revisao="alterado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Inciso>
        <TituloDispositivo>Do objeto</TituloDispositivo>
        <p>Texto original do inciso</p>
      </Inciso>
    </lexedit:RevisaoArticulacao>

    <!-- Título adicionado: o estado anterior não tem TituloDispositivo -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art6_cpt_inc2"
        revisao="alterado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Inciso>
        <p>Texto do inciso, que não tinha título</p>
      </Inciso>
    </lexedit:RevisaoArticulacao>

    <!-- Título alterado (ou removido): o estado anterior traz o título original -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art6_cpt_inc3"
        revisao="alterado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Inciso>
        <TituloDispositivo>Do <i>objeto</i> original</TituloDispositivo>
        <p>Texto do inciso, que não mudou</p>
      </Inciso>
    </lexedit:RevisaoArticulacao>

    <!-- Alteração de texto de artigo: o texto anterior fica no Caput -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art7"
        revisao="alterado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Artigo>
        <TituloDispositivo>Da vigência</TituloDispositivo>
        <Caput>
          <p>Texto original do caput</p>
        </Caput>
      </Artigo>
    </lexedit:RevisaoArticulacao>

    <!-- Movimentação de dispositivo -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art5_cpt_inc5"
        revisao="movido;3"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00"/>

    <!-- Movimentação combinada com alteração de texto -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art5_cpt_inc4"
        revisao="movido;3,alterado"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00">
      <Inciso>
        <p>Conteúdo do inciso III original.</p>
      </Inciso>
    </lexedit:RevisaoArticulacao>

    <!-- Transformação de tipo: inciso transformado em alínea -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art4_cpt_inc1_ali1"
        revisao="transformado;inciso"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00"/>

    <!-- Transformação de tipo: alínea transformada em inciso -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art4_cpt_inc2"
        revisao="transformado;alinea"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00"/>

    <!-- Alteração de rótulo em alteração de norma -->
    <lexedit:RevisaoArticulacao
        refIdDispositivo="art2_cpt_alt1_art4"
        revisao="alteracaoRotulo;art2_cpt_alt1_art3"
        refIdUsuario="sf:fulano"
        data="2026-05-11T15:51:00-03:00"/>

  </lexedit:RevisoesArticulacao>
  <lexedit:Usuarios>
    <lexedit:Usuario idUsuario='sf:fulano' nome='Fulano de Tal'/>
  </lexedit:Usuarios>
</lexedit:Metadado>
