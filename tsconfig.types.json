{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "rootDir": "./src",
    "stripInternal": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}